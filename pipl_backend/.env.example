# ── Сервер ───────────────────────────────────────────────
PORT=3000

# Окружение: development | production
NODE_ENV=development

# ── База данных (PostgreSQL) ─────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coffee_shop

# ── JWT ──────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО замените на длинный случайный секрет перед деплоем!
# Генерация: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ── Email (SMTP) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Coffee Shop <your@gmail.com>

# ── Персонал (создаются при первом запуске) ──────────────
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
OWNER_LOGIN=owner
OWNER_PASSWORD=owner123

# ── Telegram Login (персонал) ─────────────────────────────
# Username бота (публичный, для Telegram Login Widget)
# Пример: TG_BOT_USERNAME=PiplCoffee65_bot
# ⚠️ TG_BOT_TOKEN — НИКОГДА не коммить! Только в .env на сервере.
# Секретный токен бота из @BotFather:
# TG_BOT_TOKEN=
# Whitelist Telegram ID владельца/админов (через запятую).
# owner — главный доступ; admin — обычный персонал.
# Узнать свой TG ID: @userinfobot
TG_BOT_USERNAME=
OWNER_TG_IDS=1227190624
ADMIN_TG_IDS=

# ── Демо-код для входа клиентов (работает только в development) ──
DEMO_CODE=123456

# ── CORS (только для production, через запятую) ──────────
# CORS_ORIGINS=https://pipl.example.ru,https://admin.pipl.example.ru